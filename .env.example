# Copy this file to .env and fill in only the platforms you want to use.

# Mastodon: use an instance URL and an access token with write:statuses scope.
MASTODON_API_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky: use your account handle and an app password.
BLUESKY_API_BASE_URL=https://bsky.social
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Reddit: use a script application and an account permitted to post to the subreddit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=

# Telegram: bot token from @BotFather and the target public channel username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_USERNAME=

# Discord: incoming webhook URL. Guild/channel IDs are optional.
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
